<Window x:Class="Coursia.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres" Width="540" Height="590" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
    <Window.Resources>
        <Style x:Key="OptionButton" TargetType="Button"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="42" /><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="FontSize" Value="22" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D7DDE7" /><Setter Property="BorderThickness" Value="1" /></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Personnaliser Coursia" FontSize="24" FontWeight="SemiBold" Foreground="#18212F" />
        <TextBlock Grid.Row="1" Text="Les changements sont enregistrés sur cet ordinateur." Foreground="#758093" Margin="0,6,0,24" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="Couleur d'accent" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox x:Name="AccentPicker" Grid.Column="1" Height="36" Padding="8" SelectedValuePath="Tag">
                <ComboBoxItem Content="Bleu océan" Tag="#2563EB" />
                <ComboBoxItem Content="Vert forêt" Tag="#16805B" />
                <ComboBoxItem Content="Orange chaud" Tag="#D97706" />
                <ComboBoxItem Content="Rose corail" Tag="#DB4F6B" />
            </ComboBox>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,22,0,0">
            <TextBlock Text="Icône de l'application" FontWeight="SemiBold" Margin="0,0,0,10" />
            <WrapPanel>
                <Button Tag="◈" Content="◈" Click="Icon_Click" Style="{StaticResource OptionButton}" />
                <Button Tag="✦" Content="✦" Click="Icon_Click" Style="{StaticResource OptionButton}" />
                <Button Tag="◆" Content="◆" Click="Icon_Click" Style="{StaticResource OptionButton}" />
                <Button Tag="✎" Content="✎" Click="Icon_Click" Style="{StaticResource OptionButton}" />
                <Button Tag="★" Content="★" Click="Icon_Click" Style="{StaticResource OptionButton}" />
            </WrapPanel>
            <CheckBox x:Name="CompactMode" Content="Mode compact : cartes et espaces plus petits" Margin="0,24,0,0" Foreground="#18212F" />
            <Button Content="Revoir le tutoriel" HorizontalAlignment="Left" Background="Transparent" Foreground="#2563EB" Padding="0" Margin="0,18,0,0" Click="Tutorial_Click" />
            <Button Content="Réinitialiser toute l'application" HorizontalAlignment="Left" Background="Transparent" Foreground="#B42318" Padding="0" Margin="0,18,0,0" Click="Reset_Click" />
            <TextBlock Text="Supprime les matières, réglages et fichiers copiés par Coursia." Foreground="#758093" FontSize="11" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Width="95" Background="Transparent" Foreground="#596579" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Enregistrer" Width="110" Background="#2563EB" Foreground="White" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
