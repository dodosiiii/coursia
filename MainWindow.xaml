<Window x:Class="Coursia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coursia v0.4" Height="820" Width="1450" MinHeight="680" MinWidth="1120"
        Background="#F2F5F9" Foreground="#122033" WindowStartupLocation="CenterScreen" Focusable="True" KeyDown="Window_KeyDown" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Icon><BitmapImage UriSource="/Coursia;component/icone.png" /></Window.Icon>
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#66758A" />
        <SolidColorBrush x:Key="Line" Color="#DCE3EC" />
        <SolidColorBrush x:Key="Blue" Color="#0F766E" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
        <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Padding" Value="14,9" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style x:Key="ToolbarButton" TargetType="Button"><Setter Property="Height" Value="44" /><Setter Property="MinWidth" Value="112" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="15,10" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#122033" Padding="24,28">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Border BorderBrush="#263A52" BorderThickness="0,0,0,1" Padding="0,0,0,22" Margin="0,0,0,25"><Grid><StackPanel Orientation="Horizontal"><Border Width="56" Height="56" CornerRadius="15" Background="#E8F4F2" Margin="0,0,13,0"><Image Source="/Coursia;component/icone.png" Width="48" Height="48" Stretch="Uniform" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="coursia" Foreground="White" FontSize="25" FontWeight="Bold" /><TextBlock Text="v0.4  ·  ton espace d'étude" Foreground="#91A4BA" FontSize="10" Margin="1,3,0,0" /></StackPanel></StackPanel><TextBlock Text="●" Foreground="#55D6A3" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Application prête" /></Grid></Border>
                    <TextBlock Text="ton espace d'étude" Foreground="#9FAEC4" FontSize="12" Margin="1,0,0,28" />
                    <TextBlock Text="BIBLIOTHÈQUE" Foreground="#738198" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Button Content="⌂   Vue d'ensemble" HorizontalContentAlignment="Left" Background="#24415A" Foreground="White" Padding="13,11" Margin="0,0,0,10" Click="Overview_Click" />
                    <TextBlock Text="MES MATIÈRES" Foreground="#738198" FontSize="10" FontWeight="SemiBold" Margin="0,18,0,10" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><StackPanel x:Name="SectionList" /></ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Border Background="#1B3047" CornerRadius="12" Padding="9" Margin="0,0,0,12"><StackPanel><Button Content="＋   Sous-section" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#C5D0DF" Padding="9,8" Click="AddSubsection_Click" /><Button x:Name="AddSubjectButton" Content="＋   Ajouter une matière" HorizontalContentAlignment="Left" Background="#0F766E" Foreground="White" Padding="11,10" Click="AddSection_Click" /></StackPanel></Border>
                    <Border Background="#202E43" CornerRadius="9" Padding="8" Margin="0,0,0,8"><Button x:Name="PowerButton" Background="Transparent" BorderThickness="0" Padding="6" HorizontalContentAlignment="Left" Click="PowerButton_Click" ToolTip="Active ou désactive le mode économie de Coursia"><StackPanel Orientation="Horizontal"><TextBlock x:Name="BatteryIcon" Text="⌁" Foreground="#42D392" FontSize="20" Margin="0,0,9,0" VerticalAlignment="Center" /><StackPanel><TextBlock x:Name="BatteryStatusText" Text="Batterie" Foreground="#E0E7F1" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="PowerModeText" Text="Mode économie désactivé" Foreground="#9FAEC4" FontSize="10" Margin="0,2,0,0" /></StackPanel></StackPanel></Button></Border>
                    <Button Content="⚙   Paramètres" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#9FAEC4" Padding="8,8" Click="Settings_Click" />
                    <Button Content="▦   Emploi du temps" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#9FAEC4" Padding="8,8" Click="Schedule_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="42,36,34,30">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,24,0"><Button x:Name="BackToOverviewButton" Content="←  Toutes les matières" HorizontalContentAlignment="Left" Background="Transparent" Foreground="{StaticResource Blue}" Padding="0" Margin="0,0,0,10" Visibility="Collapsed" Click="Overview_Click" /><TextBlock x:Name="GreetingText" Text="Bonjour" FontSize="13" Foreground="{StaticResource Muted}" /><TextBlock x:Name="PageTitle" Text="Vue d'ensemble" FontSize="30" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Width="230" Height="42" Margin="0,0,10,0" ToolTip="Rechercher dans les matières et fichiers"><Grid><TextBlock Text="⌕" FontSize="21" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="13,0,0,2" /><TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" BorderThickness="0" Background="Transparent" Margin="40,0,10,0" VerticalContentAlignment="Center" /></Grid></Border>
                    <Button Content="＋  Matière" Background="White" BorderBrush="{StaticResource Blue}" BorderThickness="1" Foreground="{StaticResource Blue}" Margin="0,0,8,0" Style="{StaticResource ToolbarButton}" Click="AddSection_Click" />
                    <Button Content="＋  Créer" Background="{StaticResource Blue}" Foreground="White" Margin="0,0,8,0" Style="{StaticResource ToolbarButton}" Click="CreateDocument_Click" />
                    <Button Content="↥  Importer" Background="White" BorderBrush="{StaticResource Blue}" BorderThickness="1" Foreground="{StaticResource Blue}" Style="{StaticResource ToolbarButton}" Click="AddFile_Click" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#DFF2EF" CornerRadius="16" Padding="24" Margin="0,32,0,28"><Grid><StackPanel><TextBlock Text="ESPACE PERSONNEL" Foreground="#0F766E" FontSize="11" FontWeight="Bold" /><TextBlock Text="Organise tes cours à ton rythme" Foreground="#122033" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4" /><TextBlock Text="Crée une matière, ajoute tes documents et garde ton planning sous la main." Foreground="{StaticResource Muted}" /></StackPanel><Button Content="Créer une matière  →" HorizontalAlignment="Right" VerticalAlignment="Center" Background="White" Foreground="#0F766E" Padding="14,10" Click="AddSection_Click" /></Grid></Border>
            <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid Grid.Row="0" Margin="0,0,0,18"><TextBlock x:Name="CourseTitle" Text="Tes documents" FontSize="19" FontWeight="SemiBold" /><TextBlock x:Name="CourseCount" Text="0 document" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" /></Grid><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CourseCards" /></ScrollViewer></Grid>
        </Grid>
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="25,32"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Aperçu rapide" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="NextClassText" Grid.Row="1" Text="Aucun cours programmé" Foreground="#2563EB" TextWrapping="Wrap" Margin="0,6,0,12" /><TextBlock Grid.Row="2" Text="Cours aujourd'hui" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,4,0,8" /><ScrollViewer Grid.Row="3" MaxHeight="170" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TodayCourses" /></ScrollViewer><TextBlock Grid.Row="5" Text="Derniers fichiers" Foreground="{StaticResource Muted}" Margin="0,14,0,10" /><ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="RecentFiles" /></ScrollViewer><Border Grid.Row="7" Background="#F7F8FA" CornerRadius="10" Padding="15" Margin="0,20,0,0"><StackPanel><TextBlock Text="Ton espace" FontWeight="SemiBold" /><TextBlock Text="Aucune donnée n'est envoyée sur internet." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" /></StackPanel></Border></Grid></Border>
    </Grid>
</Window>
