<Window x:Class="Coursia.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Emploi du temps" Width="980" Height="720" MinWidth="860" MinHeight="620" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Mon emploi du temps" FontSize="24" FontWeight="SemiBold" Foreground="#18212F" /><TextBlock Text="Coursia reconnaît tes abréviations pour te rappeler quoi réviser." Foreground="#758093" Margin="0,6,0,22" /></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#D7DDE7" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="100" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="105" /><ColumnDefinition Width="82" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="DayPicker" Grid.Column="0" Height="34" Padding="7"><ComboBoxItem Content="Lundi" Tag="Monday" /><ComboBoxItem Content="Mardi" Tag="Tuesday" /><ComboBoxItem Content="Mercredi" Tag="Wednesday" /><ComboBoxItem Content="Jeudi" Tag="Thursday" /><ComboBoxItem Content="Vendredi" Tag="Friday" /><ComboBoxItem Content="Samedi" Tag="Saturday" /><ComboBoxItem Content="Dimanche" Tag="Sunday" /></ComboBox>
                <TextBox x:Name="StartTime" Grid.Column="1" Height="34" Text="08:00" Padding="8" Margin="8,0,0,0" ToolTip="Heure de début, ex. 08:00" />
                <TextBox x:Name="EndTime" Grid.Column="2" Height="34" Text="09:00" Padding="8" Margin="8,0,0,0" ToolTip="Heure de fin, ex. 09:00" />
                <TextBox x:Name="SubjectInput" Grid.Column="3" Height="34" Text="fr" Padding="8" Margin="8,0,0,0" ToolTip="Matière ou abréviation, ex. fr, maths, hist" />
                <ComboBox x:Name="WeekPicker" Grid.Column="4" Height="34" Margin="8,0,0,0" Padding="7" ToolTip="Afficher et ajouter pour cette semaine" SelectionChanged="WeekPicker_SelectionChanged"><ComboBoxItem Content="Semaine A" Tag="A" /><ComboBoxItem Content="Semaine B" Tag="B" /><ComboBoxItem Content="Toutes" Tag="Toutes" /></ComboBox>
                <Button Grid.Column="5" Content="Ajouter" Height="34" Margin="8,0,0,0" Background="#2563EB" Foreground="White" Click="Add_Click" />
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#EAF1FF" CornerRadius="8" Padding="10" Margin="0,0,0,12"><Grid><StackPanel Margin="0,0,170,0"><TextBlock x:Name="PdfStatus" Text="Aucun PDF d'emploi du temps ajouté" Foreground="#4771C9" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="WeekHintText" Foreground="#758093" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Ajouter PDF" Background="White" Foreground="#2563EB" Padding="10,6" Click="ImportPdf_Click" /><Button x:Name="OpenPdfButton" Content="Ouvrir" Background="Transparent" Foreground="#2563EB" Padding="10,6" Visibility="Collapsed" Click="OpenPdf_Click" /></StackPanel></Grid></Border>
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0"><TabItem Header="Liste"><ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent" /></TabItem><TabItem Header="Semaine"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Grid x:Name="WeeklyGrid" Margin="0,8,0,0" /></ScrollViewer></TabItem></TabControl>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Fermer" Width="100" Background="Transparent" Foreground="#596579" Click="Close_Click" /></StackPanel>
    </Grid>
</Window>
