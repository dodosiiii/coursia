<Window x:Class="Coursia.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue dans Coursia" Width="620" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><TextBlock Text="◈" Foreground="#2563EB" FontSize="30" FontWeight="Bold" Margin="0,0,10,0" /><StackPanel><TextBlock Text="Bienvenue dans Coursia" FontSize="24" FontWeight="SemiBold" Foreground="#18212F" /><TextBlock Text="Ton espace simple pour ranger tes cours." Foreground="#758093" Margin="0,4,0,0" /></StackPanel></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,28,0,20">
            <TextBlock Text="1   Crée une matière" FontSize="17" FontWeight="SemiBold" Foreground="#18212F" />
            <TextBlock Text="Utilise le bouton Matière pour créer Mathématiques, Histoire, Anglais..." TextWrapping="Wrap" Foreground="#758093" Margin="28,5,0,16" />
            <TextBlock Text="2   Ajoute tes fichiers" FontSize="17" FontWeight="SemiBold" Foreground="#18212F" />
            <TextBlock Text="Sélectionne ta matière, puis clique sur Document ou dépose tes fichiers dans la fenêtre." TextWrapping="Wrap" Foreground="#758093" Margin="28,5,0,16" />
            <TextBlock Text="3   Organise par sous-section" FontSize="17" FontWeight="SemiBold" Foreground="#18212F" />
            <TextBlock Text="Crée des chapitres ou des dossiers pour retrouver rapidement chaque cours." TextWrapping="Wrap" Foreground="#758093" Margin="28,5,0,0" />
        </StackPanel>
        <Button Grid.Row="2" Content="Commencer" Width="120" HorizontalAlignment="Right" Background="#2563EB" Foreground="White" Click="Start_Click" />
    </Grid>
</Window>
