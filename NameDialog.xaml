<Window x:Class="Coursia.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coursia" Width="500" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
    <Window.Resources>
        <Style x:Key="IconOption" TargetType="Button"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="38" /><Setter Property="Margin" Value="0,0,7,0" /><Setter Property="FontSize" Value="20" /><Setter Property="Foreground" Value="#2563EB" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D7DDE7" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="ColorOption" TargetType="Button"><Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Margin" Value="0,0,9,0" /><Setter Property="BorderBrush" Value="White" /><Setter Property="BorderThickness" Value="3" /></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="DialogTitle" Text="Nouvelle matière" FontSize="21" FontWeight="SemiBold" Foreground="#18212F" />
        <TextBlock x:Name="DialogHint" Grid.Row="1" Text="Donne un nom facile à retrouver." Foreground="#758093" Margin="0,7,0,12" />
        <TextBox x:Name="NameInput" Grid.Row="2" Height="40" Padding="11,8" FontSize="14" VerticalContentAlignment="Center" BorderBrush="#D7DDE7" Background="White" />
        <TextBlock Grid.Row="3" Text="Choisis une icône" FontWeight="SemiBold" Margin="0,18,0,9" />
        <WrapPanel Grid.Row="4"><Button Tag="◈" Content="◈" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="✦" Content="✦" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="◆" Content="◆" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="✎" Content="✎" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="★" Content="★" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="▣" Content="▣" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="☼" Content="☼" Click="Icon_Click" Style="{StaticResource IconOption}" /><Button Tag="♫" Content="♫" Click="Icon_Click" Style="{StaticResource IconOption}" /></WrapPanel>
        <StackPanel Grid.Row="5" Margin="0,14,0,0"><TextBlock Text="Couleur" FontWeight="SemiBold" Margin="0,0,0,8" /><StackPanel Orientation="Horizontal"><Button Tag="#2563EB" Background="#2563EB" Click="Color_Click" Style="{StaticResource ColorOption}" /><Button Tag="#16805B" Background="#16805B" Click="Color_Click" Style="{StaticResource ColorOption}" /><Button Tag="#D97706" Background="#D97706" Click="Color_Click" Style="{StaticResource ColorOption}" /><Button Tag="#DB4F6B" Background="#DB4F6B" Click="Color_Click" Style="{StaticResource ColorOption}" /><Button Tag="#7C3AED" Background="#7C3AED" Click="Color_Click" Style="{StaticResource ColorOption}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button Content="Annuler" Width="92" Margin="0,0,8,0" Background="Transparent" Foreground="#596579" Click="Cancel_Click" /><Button Content="Créer" Width="92" Background="#2563EB" Foreground="White" Click="Confirm_Click" /></StackPanel></StackPanel>
    </Grid>
</Window>
