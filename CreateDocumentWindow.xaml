<Window x:Class="Coursia.CreateDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau fichier · Coursia v0.4" Width="600" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F2F5F9">
    <Window.Resources>
        <Style x:Key="FileTypeButton" TargetType="RadioButton">
            <Setter Property="Width" Value="150" /><Setter Property="Height" Value="105" /><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="Padding" Value="10" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D7DDE7" /><Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="CreateAction" TargetType="Button"><Setter Property="Height" Value="42" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="16,9" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="Créer un nouveau fichier" FontSize="23" FontWeight="SemiBold" Foreground="#18212F" />
        <TextBlock Grid.Row="1" Text="Choisis un format, puis donne un nom à ton fichier." Foreground="#758093" Margin="0,6,0,20" />
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <RadioButton x:Name="WordOption" GroupName="FileType" IsChecked="True" Style="{StaticResource FileTypeButton}">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="W" FontSize="28" FontWeight="Bold" Foreground="#185ABD" HorizontalAlignment="Center" /><TextBlock Text="Document Word" FontSize="12" Foreground="#18212F" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="PowerPointOption" GroupName="FileType" Style="{StaticResource FileTypeButton}">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="P" FontSize="28" FontWeight="Bold" Foreground="#C43E1C" HorizontalAlignment="Center" /><TextBlock Text="Présentation" FontSize="12" Foreground="#18212F" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="TextOption" GroupName="FileType" Style="{StaticResource FileTypeButton}">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="TXT" FontSize="22" FontWeight="Bold" Foreground="#4B5563" HorizontalAlignment="Center" /><TextBlock Text="Texte simple" FontSize="12" Foreground="#18212F" HorizontalAlignment="Center" /></StackPanel>
            </RadioButton>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="Nom du fichier" FontWeight="SemiBold" Margin="0,0,0,7" /><TextBox x:Name="FileNameInput" Height="38" Padding="10,7" FontSize="14" VerticalContentAlignment="Center" BorderBrush="#D7DDE7" Background="White" /></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Annuler" Width="100" Height="42" Background="Transparent" Foreground="#596579" Margin="0,0,8,0" Click="Cancel_Click" /><Button Content="Créer le fichier" Width="145" Background="#0F766E" Foreground="White" Style="{StaticResource CreateAction}" Click="Create_Click" /></StackPanel>
    </Grid>
</Window>
