<Window x:Class="Coursia.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes" Width="650" Height="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F7F8FA">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Text="Notes" FontSize="24" FontWeight="SemiBold" Foreground="#18212F" />
        <TextBlock Grid.Row="1" Text="Écris un résumé, une idée ou les points à revoir." Foreground="#758093" Margin="0,6,0,14" />
        <TextBox x:Name="NotesInput" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" Background="White" BorderBrush="#D7DDE7" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Annuler" Width="95" Background="Transparent" Foreground="#596579" Margin="0,0,8,0" Click="Cancel_Click" /><Button Content="Enregistrer" Width="110" Background="#2563EB" Foreground="White" Click="Save_Click" /></StackPanel>
    </Grid>
</Window>
